{
  "expo": {
    "name": "Techno CRM",
    "slug": "techno-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.technosyncinnovations.ptplcrm"
    },
